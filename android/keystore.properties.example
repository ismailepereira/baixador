# Renomeie este arquivo para keystore.properties e preencha.
# NÃO comite o keystore.properties no Git (já está no .gitignore).

# --- Spotify (opcional, só se quiser baixar do Spotify) ---
# Crie um app em https://developer.spotify.com/dashboard
spotify.clientId=
spotify.clientSecret=

# --- Assinatura release (opcional, só pra gerar APK release) ---
# Gere com: keytool -genkey -v -keystore baixador.keystore -alias baixador -keyalg RSA -keysize 2048 -validity 10000
# storeFile=baixador.keystore
# storePassword=
# keyAlias=baixador
# keyPassword=
