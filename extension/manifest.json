{
  "manifest_version": 3,
  "name": "Baixador",
  "version": "1.1.3",
  "description": "Baixa videos e audios de YouTube, Instagram, Facebook, Spotify e outros sites.",
  "permissions": ["activeTab", "scripting", "storage", "notifications", "downloads", "cookies", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:5005/*",
    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.spotify.com/*",
    "https://*.tiktok.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.twitch.tv/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Baixador",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Abrir/fechar o painel do Baixador"
    },
    "quick-download": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Baixar vídeo da aba atual (qualidade padrão)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.tiktok.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.twitch.tv/*",
        "https://*.spotify.com/*",
        "https://open.spotify.com/*"
      ],
      "js": ["i18n.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
